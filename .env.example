# Application
APP_NAME=cobalt-lens
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite:///./cobalt_lens.db

# API
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Parser
MAX_FILE_SIZE_MB=10
PARSE_TIMEOUT_SECONDS=30

# LLM (optional, opt-in)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# Auth (future)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=